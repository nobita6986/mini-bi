# ---------------------------------------------------------------------------
# Biến môi trường — CHỈ chứa tên biến và placeholder.
# KHÔNG commit giá trị thật. File .env.local / .env.*.local đã bị gitignore.
# Nguồn cấu hình DEV: xem docs/handoffs/p0-t1-g1.md (không chứa secret).
# ---------------------------------------------------------------------------

# Public: được nhúng vào bundle trình duyệt. Chỉ dùng cho truy cập công khai.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable-or-anon-key>

# Server-only: TUYỆT ĐỐI không đặt tiền tố NEXT_PUBLIC_.
# Key có quyền cao (bypass RLS). Chỉ dùng trong server runtime.
SUPABASE_SECRET_KEY=<service-role-key>

# Server-only: deployment safety guard cho route /pipeline-check.
# - pnpm dev: route luôn được phép (không cần set).
# - production (pnpm start / đã build): route trả notFound() trừ khi đặt = "true".
# KHÔNG phải authentication. Dữ liệu thật/BoD vẫn cần access gate P1-W03.
PIPELINE_CHECK_ENABLED=false

# Server-only: session bootstrap API gate for `/api/direct-entry/session`.
# Missing or any value other than exactly "true" returns 404 before session/DB access.
DIRECT_ENTRY_API_ENABLED=false

# Server-only UI/API feature gates used by VPS production preflight.
DIRECT_ENTRY_UI_ENABLED=false
WORK_REPORTS_API_ENABLED=false

# Mobile attendance. Production requires both values and a dedicated secret.
ATTENDANCE_ENABLED=false
ATTENDANCE_TIME_TOKEN_SECRET=<dedicated-random-secret-32-plus-ascii-characters>

# Private R2 object storage. Production uses `production` + `hrp-bi-product`.
DOCUMENT_STORAGE_ENVIRONMENT=preview
R2_ACCOUNT_ID=<cloudflare-account-id>
R2_BUCKET_NAME=hrp-bi-preview
R2_ACCESS_KEY_ID=<r2-access-key-id>
R2_SECRET_ACCESS_KEY=<r2-secret-access-key>

# P1.7-H04: Pilot HTTP Basic Auth đã bị loại bỏ. Preview/Production đi thẳng tới
# Supabase login/session; không còn biến PILOT_ACCESS_*.

# Server-only: dùng cho script migration / kiểm tra fixture chạy ngoài Next.js.
# Không được nạp vào web runtime. Có thể đặt trong .env.local (đã gitignore).
SUPABASE_DB_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# Server-only (không bắt buộc): host Supavisor pooler IPv4 khi host db.<ref> chỉ có AAAA.
# Đặt trong .env.local cùng với DB URL; không commit.
SUPABASE_POOLER_HOST=aws-0-<region>.pooler.supabase.com
SUPABASE_POOLER_PORT=5432

# Đường dẫn file cấu hình ngoài repo (script migration/fixture). Không commit.
SUPABASE_CONFIG_FILE=C:\CodeApp\supabase-bi.txt

# ---------------------------------------------------------------------------
# P1.5-W04 — AI report gateway (server-only). KHÔNG đặt tiền tố NEXT_PUBLIC_.
# ---------------------------------------------------------------------------
# Công tắc tổng: production thiếu AI_REPORTS_ENABLED=true ⇒ mọi route AI trả AI_DISABLED
# (fail closed TRƯỚC DB/config/provider). Mặc định TẮT.
AI_REPORTS_ENABLED=false

# Provider: W04 chỉ cho "scripted" (deterministic, không gọi mạng).
# "live" luôn bị chặn cho tới khi G4A duyệt provider/model/allowlist/ngân sách.
AI_PROVIDER_KEY=scripted
AI_MODEL_KEY=scripted-deterministic-v1

# Prompt version (manifest bất biến trong code: src/lib/ai/gateway/prompt-registry.mjs).
AI_PROMPT_VERSION=business-analysis-prompt/1.0

# Token nội bộ cho worker boundary POST /api/ai/worker/run (gửi qua header x-ai-worker-token).
AI_WORKER_TOKEN=<internal-worker-token>

# Fast-path tuỳ chọn: chạy MỘT bước worker sau khi response enqueue xong.
# KHÔNG phải durability guarantee — row trong DB vẫn là authority. Mặc định TẮT.
AI_INLINE_WORKER_ENABLED=false

# Policy bắt buộc (production thiếu ⇒ AI_POLICY_REQUIRED; dev dùng mặc định kỹ thuật).
# Đây là trần KỸ THUẬT + trần token, KHÔNG phải ngân sách tiền thật.
AI_POLICY_WINDOW_MS=60000
AI_POLICY_MAX_REQUESTS_PER_WINDOW=6
AI_POLICY_MAX_CONCURRENT_JOBS=2
AI_POLICY_MAX_ATTEMPTS=3
AI_POLICY_PROVIDER_TIMEOUT_MS=30000
AI_POLICY_MAX_RESPONSE_BYTES=131072
AI_POLICY_MAX_PAYLOAD_BYTES=262144
AI_POLICY_DAILY_TOKEN_CEILING=2000000

# ---------------------------------------------------------------------------
# Attendance Backend WP1 (server-only). KHÔNG đặt tiền tố NEXT_PUBLIC_.
# ---------------------------------------------------------------------------
# Công tắc tổng: chỉ bật khi đặt chính xác = "true"; khi tắt trả 404.
ATTENDANCE_ENABLED=false

# Secret riêng ký HMAC-SHA256 cho time token của /api/attendance/time (>= 32 ký tự).
# KHÔNG dùng lại SUPABASE_SECRET_KEY, R2_SECRET_ACCESS_KEY, AI key hoặc secret khác.
ATTENDANCE_TIME_TOKEN_SECRET=<attendance-time-token-secret>
