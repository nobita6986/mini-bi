# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# .env.example là template KHÔNG chứa secret -> được commit
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
# ---------------------------------------------------------------------------
# mini-bi project rules
# ---------------------------------------------------------------------------

# Secrets: không bao giờ commit cấu hình môi trường thật
.env.local
.env.*.local
supabase-bi.txt

# Tài liệu nguồn có thể chứa dữ liệu cá nhân (PII) — không đưa vào Git.
docs/*.xlsx
docs/~$*

# Vercel / build
.vercel
.turbo

# Chứng chỉ công khai được pin có chủ đích (không phải secret).
# Luật "*.pem" ở trên loại trừ tất cả; mở ngoại lệ cho CA của Supabase pooler.
!supabase/certs/*.pem
